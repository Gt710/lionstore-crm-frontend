# ============================================================
# Kotlin Multiplatform / Compose Multiplatform .gitignore
# Targets: Android, WasmJs, JS, JVM, Desktop
# ============================================================

# ----------------------------
# Gradle
# ----------------------------
.gradle/
**/build/
!src/**/build/
gradle/wrapper/gradle-wrapper.jar
gradle-app.setting
!gradle/wrapper/gradle-wrapper.properties

# ----------------------------
# Kotlin
# ----------------------------
.kotlin/

# ----------------------------
# IDE — IntelliJ IDEA / Android Studio
# ----------------------------
.idea/
*.iml
*.ipr
*.iws
out/

# ----------------------------
# Android
# ----------------------------
local.properties
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
gen/
lint/
proguard/

# ----------------------------
# macOS
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ----------------------------
# Windows
# ----------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------
# Xcode / iOS (якщо є)
# ----------------------------
xcuserdata/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
*.xcarchive
*.xcframework

# ----------------------------
# Node.js / JS / WasmJs
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
kotlin-js-store/
.yarn/
.pnp.*

# ----------------------------
# Kotlin JS store (yarn/npm lock is tracked, cache is not)
# ----------------------------
kotlin-js-store/.yarn/

# ----------------------------
# Compose / Multiplatform generated
# ----------------------------
**/composeApp/build/
**/shared/build/
**/androidApp/build/
**/desktopApp/build/
**/webApp/build/

# ----------------------------
# Logs
# ----------------------------
*.log
*.log.*

# ----------------------------
# Credentials / Secrets
# ----------------------------
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
